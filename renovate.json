{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration"
  ],
  "dependencyDashboard": true,
  "timezone": "America/Mexico_City",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "automerge": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Group and schedule minor and patch updates for Monday early mornings (excluding GitHub Actions and Python, which have their own rules)",
      "matchManagers": ["!github-actions"],
      "matchPackageNames": ["!python", "!mcr.microsoft.com/devcontainers/python"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch dependencies",
      "schedule": ["* 0-5 * * 1"]
    },
    {
      "description": "Pin digests, group, and schedule GitHub Actions updates for Monday early mornings. Excludes setup-python's python-version and floating hassfest/HACS actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "!python",
        "!home-assistant/actions",
        "!hacs/action"
      ],
      "pinDigests": true,
      "groupName": "GitHub Actions",
      "schedule": ["* 0-5 * * 1"]
    },
    {
      "description": "Python upgrades need Home Assistant support first: bump target-version in pyproject.toml in the same PR",
      "matchPackageNames": ["python", "mcr.microsoft.com/devcontainers/python"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "Python"
    },
    {
      "description": "MCR publishes no release timestamps, so the minimum release age could never be met",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/**"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
